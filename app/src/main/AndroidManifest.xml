<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Keeper deliberately declares no INTERNET permission. Bundled ML Kit transitively brings
      Google datatransport, which injects android.permission.INTERNET and telemetry services.
      Refuse the permission at merge time and remove the telemetry entry points. The on-device
      model remains bundled; the app process has no network capability.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.biometrics.face"
        android:required="false" />

    <!--
      Android 11+ package visibility: the root probe checks only these known root-manager
      packages. Declaring them explicitly keeps detection working without requesting
      QUERY_ALL_PACKAGES, which would expose every installed app to Keeper.
    -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.zachspong.temprootremovejb" />
        <package android:name="com.ramdroid.appquarantine" />
    </queries>

    <application
        android:name="com.keeper.vault.app.KeeperApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_keeper"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keeper"
        android:usesCleartextTraffic="false">

        <activity
            android:name="com.keeper.vault.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.keeper.vault.app.SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name="com.keeper.vault.app.network.NetworkCheckActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name="com.keeper.vault.auth.SecretSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.keeper.vault.auth.UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.keeper.vault.vault.VaultActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.keeper.vault.presence.PresenceEnrollmentActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.keeper.vault.isolation.TamperLogActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.keeper.vault.duress.IntruderSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.keeper.vault.duress.IntruderLogActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name="com.keeper.vault.presence.PresenceShieldService"
            android:exported="false"
            android:foregroundServiceType="camera"
            android:stopWithTask="true" />
        <service
            android:name="com.keeper.vault.duress.IntruderCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera"
            android:stopWithTask="true" />

        <!-- ML Kit telemetry strip: keep the bundled model, remove the upload pipeline. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
